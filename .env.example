# finops-cost-agent — copy to .env; every variable is optional.
PORT=4030

# Bearer token required on every route except /health. Empty = auth disabled (logged as a warning).
FINOPS_API_TOKEN=

# SQLite audit store; the container uses /data/finops_audit.db.
FINOPS_DB_PATH=finops_audit.db

# Body limit for regular requests.
FINOPS_MAX_BODY_BYTES=1048576

# Body limit for POST /api/v1/analyze.
FINOPS_MAX_BULK_BODY_BYTES=8388608

# 1 = silence per-request access logs.
FINOPS_QUIET=0
